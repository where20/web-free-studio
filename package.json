{
  "name": "web-free-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PabaTV 视频生成能力的本地落地服务：账号池 + 浏览器执行通道 + 本地任务/资产库",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/cli.mjs serve",
    "account": "node server/cli.mjs account add",
    "accounts": "node server/cli.mjs account list",
    "sync": "node server/cli.mjs sync",
    "gen": "node server/cli.mjs generate",
    "doctor": "node server/cli.mjs doctor",
    "test": "node --test test/*.test.mjs",
    "clean-wm": "node scripts/clean-watermark.mjs"
  }
}
